VITE_MAPTILER_API_KEY=

# Database Configuration
DATABASE_URL=./data/portfolio.db

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin CORS Configuration
ADMIN_CORS_ORIGINS=http://localhost:3000,http://localhost:5010

# Server Configuration
NODE_ENV=development
PORT=5010
HOST=0.0.0.0

# Note: GitHub token is now required per-request in the admin dashboard for security
# No longer stored in environment variables
